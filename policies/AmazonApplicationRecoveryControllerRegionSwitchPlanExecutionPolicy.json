{
  "Arn": "arn:aws:iam::aws:policy/AmazonApplicationRecoveryControllerRegionSwitchPlanExecutionPolicy",
  "CreateDate": "2025-11-03T19:34:08Z",
  "DefaultVersionId": "v5",
  "IsAttachable": true,
  "Path": "/",
  "PolicyId": "ANPAZKAPJZG4EL57A4O72",
  "PolicyName": "AmazonApplicationRecoveryControllerRegionSwitchPlanExecutionPolicy",
  "PolicyVersion": {
    "CreateDate": "2026-10-02T18:57:08Z",
    "Document": {
      "Statement": [
        {
          "Action": "servicequotas:RequestServiceQuotaIncrease",
          "Condition": {
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}"
            }
          },
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "ServiceQuotasWrite"
        },
        {
          "Action": "iam:SimulatePrincipalPolicy",
          "Effect": "Allow",
          "Resource": "arn:aws:iam::*:role/*",
          "Sid": "PlanEvaluation"
        },
        {
          "Action": [
            "arc-region-switch:GetPlan",
            "arc-region-switch:GetPlanExecution",
            "arc-region-switch:ListPlanExecutions"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "GetPlanAndExecutions"
        },
        {
          "Action": [
            "cloudwatch:DescribeAlarmHistory",
            "cloudwatch:DescribeAlarms",
            "cloudwatch:GetMetricStatistics"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "CloudWatch"
        },
        {
          "Action": [
            "servicequotas:GetRequestedServiceQuotaChange",
            "servicequotas:GetServiceQuota"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "ServiceQuotasRead"
        }
      ],
      "Version": "2012-10-17"
    },
    "IsDefaultVersion": true,
    "VersionId": "v5"
  },
  "UpdateDate": "2026-10-02T18:57:08Z"
}
