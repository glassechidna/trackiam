{
  "Arn": "arn:aws:iam::aws:policy/aws-service-role/AWSCloudWatchOmniServiceRolePolicy",
  "CreateDate": "2026-09-22T05:37:07Z",
  "DefaultVersionId": "v3",
  "IsAttachable": true,
  "Path": "/aws-service-role/",
  "PolicyId": "ANPAZKAPJZG4ECNQRFG6D",
  "PolicyName": "AWSCloudWatchOmniServiceRolePolicy",
  "PolicyVersion": {
    "CreateDate": "2026-11-23T22:57:06Z",
    "Document": {
      "Statement": [
        {
          "Action": "account:GetAccountInformation",
          "Condition": {
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}"
            }
          },
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "GetAwsAccountInformation"
        },
        {
          "Action": "cloudwatch:CreateIntegration",
          "Condition": {
            "ForAllValues:StringEquals": {
              "aws:TagKeys": "CloudWatchOmniManaged"
            },
            "StringEquals": {
              "aws:RequestTag/CloudWatchOmniManaged": "true",
              "aws:ResourceAccount": "${aws:PrincipalAccount}"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:cloudwatch:*:*:integration/*",
          "Sid": "CreateManagedCloudWatchIntegration"
        },
        {
          "Action": "cloudwatch:DeleteIntegration",
          "Condition": {
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}",
              "aws:ResourceTag/CloudWatchOmniManaged": "true"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:cloudwatch:*:*:integration/*",
          "Sid": "DeleteManagedCloudWatchIntegration"
        },
        {
          "Action": "cloudwatch:ListIntegrations",
          "Condition": {
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}"
            }
          },
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "ListCloudWatchIntegration"
        },
        {
          "Action": "iam:AttachRolePolicy",
          "Condition": {
            "ArnEquals": {
              "iam:PolicyARN": [
                "arn:aws:iam::aws:policy/AIDevOpsAgentFullAccess",
                "arn:aws:iam::aws:policy/CloudWatchOmniAWSIntegrationPolicyV2",
                "arn:aws:iam::aws:policy/CloudWatchOmniModelInferencePolicy"
              ]
            },
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:iam::*:role/service-role/CloudWatchOmniSpaceDataAccessRole-Org*",
          "Sid": "AttachOptionalSpaceAccessPolicies"
        },
        {
          "Action": "iam:CreateServiceLinkedRole",
          "Condition": {
            "StringEquals": {
              "iam:AWSServiceName": "config.amazonaws.com"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:iam::*:role/aws-service-role/config.amazonaws.com/AWSServiceRoleForConfig",
          "Sid": "CreateConfigServiceLinkedRole"
        },
        {
          "Action": "iam:GetRole",
          "Condition": {
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}"
            }
          },
          "Effect": "Allow",
          "Resource": [
            "arn:aws:iam::*:role/service-role/AgentCoreEvaluationRole-Org*",
            "arn:aws:iam::*:role/service-role/CloudWatchOmniAWSIntegrationRole-*",
            "arn:aws:iam::*:role/service-role/CloudWatchOmniDatasetIntegrationRole-Org*",
            "arn:aws:iam::*:role/service-role/CloudWatchOmniProvisioningRole",
            "arn:aws:iam::*:role/service-role/CloudWatchOmniSpaceDataAccessRole-Org*"
          ],
          "Sid": "GetCloudWatchOmniRoles"
        },
        {
          "Action": "iam:PassRole",
          "Condition": {
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}",
              "iam:PassedToService": "cloudwatch.amazonaws.com"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:iam::*:role/service-role/CloudWatchOmniAWSIntegrationRole-*",
          "Sid": "PassRolePermissionForCloudWatchOmniAWSIntegrationRole"
        },
        {
          "Action": [
            "cloudwatch:TagResource"
          ],
          "Condition": {
            "ForAllValues:StringEquals": {
              "aws:TagKeys": "CloudWatchOmniManaged"
            },
            "StringEquals": {
              "aws:RequestTag/CloudWatchOmniManaged": "true",
              "aws:ResourceAccount": "${aws:PrincipalAccount}",
              "aws:ResourceTag/CloudWatchOmniManaged": "true"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:cloudwatch:*:*:integration/*",
          "Sid": "TagOperationForCloudWatchIntegration"
        },
        {
          "Action": [
            "iam:AttachRolePolicy",
            "iam:CreateRole"
          ],
          "Condition": {
            "ArnEquals": {
              "iam:RoleTemplateARN": "arn:aws:iam::aws:role-template/cloudwatch.amazonaws.com/CloudWatchOmniAWSIntegrationForOrgRoleTemplate:1"
            },
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:iam::*:role/service-role/CloudWatchOmniAWSIntegrationRole-*",
          "Sid": "CreateCloudWatchOmniAWSIntegrationRole"
        },
        {
          "Action": [
            "iam:AttachRolePolicy",
            "iam:CreateRole"
          ],
          "Condition": {
            "ArnEquals": {
              "iam:RoleTemplateARN": "arn:aws:iam::aws:role-template/cloudwatch.amazonaws.com/CloudWatchOmniProvisioningRoleTemplate:1"
            },
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:iam::*:role/service-role/CloudWatchOmniProvisioningRole",
          "Sid": "CreateCloudWatchOmniProvisioningRole"
        },
        {
          "Action": [
            "iam:AttachRolePolicy",
            "iam:CreateRole"
          ],
          "Condition": {
            "ArnEquals": {
              "iam:RoleTemplateARN": "arn:aws:iam::aws:role-template/cloudwatch.amazonaws.com/CloudWatchOmniSpaceAccessRoleTemplate:1"
            },
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:iam::*:role/service-role/CloudWatchOmniSpaceDataAccessRole-Org*",
          "Sid": "CreateCloudWatchOmniSpaceAccessRole"
        },
        {
          "Action": [
            "iam:CreateRole",
            "iam:PutRolePolicy"
          ],
          "Condition": {
            "ArnEquals": {
              "iam:RoleTemplateARN": "arn:aws:iam::aws:role-template/bedrock-agentcore.amazonaws.com/BedrockAgentCoreEvaluationCloudWatchBedockRoleTemplate:2"
            },
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:iam::*:role/service-role/AgentCoreEvaluationRole-Org*",
          "Sid": "CreateAgentCoreEvaluationRole"
        },
        {
          "Action": [
            "iam:CreateRole",
            "iam:PutRolePolicy"
          ],
          "Condition": {
            "ArnEquals": {
              "iam:RoleTemplateARN": "arn:aws:iam::aws:role-template/logs.amazonaws.com/CloudWatchOmniDatasetIntegrationExecutionRoleTemplate:1"
            },
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:iam::*:role/service-role/CloudWatchOmniDatasetIntegrationRole-Org*",
          "Sid": "CreateCloudWatchOmniDatasetIntegrationRole"
        },
        {
          "Action": [
            "iam:ListRoles",
            "iam:ListUsers"
          ],
          "Condition": {
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}"
            }
          },
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "ListIamUsersAndRoles"
        },
        {
          "Action": "iam:GetRoleTemplateVersion",
          "Effect": "Allow",
          "Resource": [
            "arn:aws:iam::aws:role-template/bedrock-agentcore.amazonaws.com/BedrockAgentCoreEvaluationCloudWatchBedockRoleTemplate:2",
            "arn:aws:iam::aws:role-template/cloudwatch.amazonaws.com/CloudWatchOmni*",
            "arn:aws:iam::aws:role-template/logs.amazonaws.com/CloudWatchOmniDatasetIntegrationExecutionRoleTemplate:1"
          ],
          "Sid": "ReadRoleTemplate"
        },
        {
          "Action": [
            "config:DeleteServiceLinkedConfigurationRecorder",
            "config:DescribeConfigurationRecorderStatus",
            "config:PutServiceLinkedConfigurationRecorder"
          ],
          "Effect": "Allow",
          "Resource": "arn:aws:config:*:*:configuration-recorder/AWSConfigurationRecorderForCloudWatch/*",
          "Sid": "ManageConfigServiceLinkedRecorder"
        }
      ],
      "Version": "2012-10-17"
    },
    "IsDefaultVersion": true,
    "VersionId": "v3"
  },
  "UpdateDate": "2026-11-23T22:57:06Z"
}
