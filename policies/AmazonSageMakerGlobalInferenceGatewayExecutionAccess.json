{
  "Arn": "arn:aws:iam::aws:policy/AmazonSageMakerGlobalInferenceGatewayExecutionAccess",
  "CreateDate": "2026-11-17T23:37:08Z",
  "DefaultVersionId": "v1",
  "IsAttachable": true,
  "Path": "/",
  "PolicyId": "ANPAZKAPJZG4MH47HXFFZ",
  "PolicyName": "AmazonSageMakerGlobalInferenceGatewayExecutionAccess",
  "PolicyVersion": {
    "CreateDate": "2026-11-17T23:37:08Z",
    "Document": {
      "Statement": [
        {
          "Action": "kms:Decrypt",
          "Condition": {
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}"
            },
            "StringLike": {
              "kms:EncryptionContext:aws:s3:arn": "arn:aws:s3:::hyperpod-tls*",
              "kms:ViaService": "s3.*.amazonaws.com"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:kms:*:*:key/*",
          "Sid": "DecryptGIGCertificate"
        },
        {
          "Action": "s3:GetObject",
          "Condition": {
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}",
              "s3:ExistingObjectTag/CreatedBy": "HyperPodInference"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:s3:::hyperpod-tls*/*gig/*/*-certificate-*.pem",
          "Sid": "ReadGIGCertificate"
        },
        {
          "Action": "sagemaker:DescribeCluster",
          "Condition": {
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:sagemaker:*:*:cluster/*",
          "Sid": "DescribeHyperPodCluster"
        },
        {
          "Action": [
            "eks:AccessKubernetesApi",
            "eks:MutateViaKubernetesApi"
          ],
          "Condition": {
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:eks:*:*:cluster/*",
          "Sid": "ReachMemberClusterApi"
        }
      ],
      "Version": "2012-10-17"
    },
    "IsDefaultVersion": true,
    "VersionId": "v1"
  },
  "UpdateDate": "2026-11-17T23:37:08Z"
}
