{
  "Arn": "arn:aws:iam::aws:policy/PartnerCentralAccountManagementUserRoleAssociation",
  "CreateDate": "2023-11-10T02:03:40Z",
  "DefaultVersionId": "v2",
  "IsAttachable": true,
  "Path": "/",
  "PolicyId": "ANPAZKAPJZG4MONSUE2UX",
  "PolicyName": "PartnerCentralAccountManagementUserRoleAssociation",
  "PolicyVersion": {
    "CreateDate": "2026-10-16T01:27:08Z",
    "Document": {
      "Statement": [
        {
          "Action": [
            "iam:PassRole"
          ],
          "Condition": {
            "StringEquals": {
              "iam:PassedToService": "partnercentral-account-management.amazonaws.com"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:iam::*:role/PartnerCentralRoleFor*",
          "Sid": "PassPartnerCentralRole"
        },
        {
          "Action": [
            "partnercentral:GetPartnerCentralContentDocument",
            "partnercentral:GetPartnerCentralContentMetadata",
            "partnercentral:ListPartnerCentralContent",
            "partnercentral:SearchPartnerCentralContent"
          ],
          "Condition": {
            "StringEquals": {
              "partnercentral:Catalog": [
                "AWS",
                "Sandbox"
              ]
            }
          },
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "PartnerCentralContentAccess"
        },
        {
          "Action": [
            "iam:ListRoles",
            "partnercentral-account-management:AssociatePartnerUser",
            "partnercentral-account-management:DisassociatePartnerUser"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "PartnerUserRoleAssociation"
        }
      ],
      "Version": "2012-10-17"
    },
    "IsDefaultVersion": true,
    "VersionId": "v2"
  },
  "UpdateDate": "2026-10-16T01:27:08Z"
}
