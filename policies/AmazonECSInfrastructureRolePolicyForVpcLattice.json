{
  "Arn": "arn:aws:iam::aws:policy/AmazonECSInfrastructureRolePolicyForVpcLattice",
  "CreateDate": "2024-11-15T20:02:55Z",
  "DefaultVersionId": "v2",
  "IsAttachable": true,
  "Path": "/",
  "PolicyId": "ANPAZKAPJZG4LAY36SJ4I",
  "PolicyName": "AmazonECSInfrastructureRolePolicyForVpcLattice",
  "PolicyVersion": {
    "CreateDate": "2026-09-29T15:57:07Z",
    "Document": {
      "Statement": [
        {
          "Action": "vpc-lattice:GetRule",
          "Effect": "Allow",
          "Resource": [
            "arn:aws:vpc-lattice:*:*:service/*/listener/*/rule/*"
          ],
          "Sid": "GetRule"
        },
        {
          "Action": "vpc-lattice:GetTargetGroup",
          "Effect": "Allow",
          "Resource": [
            "arn:aws:vpc-lattice:*:*:targetgroup/*"
          ],
          "Sid": "DescribeVpcLatticeTargetGroup"
        },
        {
          "Action": "vpc-lattice:ListTargets",
          "Effect": "Allow",
          "Resource": [
            "arn:aws:vpc-lattice:*:*:targetgroup/*"
          ],
          "Sid": "ListVpcLatticeTargets"
        },
        {
          "Action": "vpc-lattice:UpdateListener",
          "Effect": "Allow",
          "Resource": [
            "arn:aws:vpc-lattice:*:*:service/*/listener/*"
          ],
          "Sid": "UpdateListener"
        },
        {
          "Action": "vpc-lattice:UpdateRule",
          "Effect": "Allow",
          "Resource": [
            "arn:aws:vpc-lattice:*:*:service/*/listener/*/rule/*"
          ],
          "Sid": "UpdateRule"
        },
        {
          "Action": [
            "ec2:DescribeInstances",
            "ec2:DescribeSubnets",
            "ec2:DescribeVpcs"
          ],
          "Effect": "Allow",
          "Resource": [
            "*"
          ],
          "Sid": "DescribeEc2Resources"
        },
        {
          "Action": [
            "vpc-lattice:DeregisterTargets",
            "vpc-lattice:RegisterTargets"
          ],
          "Effect": "Allow",
          "Resource": [
            "arn:aws:vpc-lattice:*:*:targetgroup/*"
          ],
          "Sid": "ManagedVpcLatticeTargetRegistration"
        }
      ],
      "Version": "2012-10-17"
    },
    "IsDefaultVersion": true,
    "VersionId": "v2"
  },
  "UpdateDate": "2026-09-29T15:57:07Z"
}
