          "Condition": {
            "ForAllValues:StringEquals": {
              "aws:TagKeys": [
                "NetworkScopeId"
              ]
            },
            "Null": {
              "aws:ResourceTag/NetworkScopeId": "false"
            }
          },
          "Effect": "Allow",
          "Resource": [
            "arn:aws:organizations::*:policy/o-*/network_security_director_policy/*"
