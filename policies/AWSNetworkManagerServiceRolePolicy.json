        {
          "Action": [
            "organizations:AttachPolicy",
            "organizations:DetachPolicy"
          ],
          "Condition": {
            "Null": {
              "aws:ResourceTag/NetworkScopeId": "false"
            }
          },
          "Effect": "Allow",
          "Resource": [
            "arn:aws:organizations::*:policy/o-*/network_security_director_policy/*"
          ],
          "Sid": "NSDOrgPolicyAttachPolicy"
