        {
          "Action": [
            "organizations:CreatePolicy",
            "organizations:TagResource"
          ],
          "Condition": {
            "ForAllValues:StringEquals": {
              "aws:TagKeys": [
                "NetworkScopeId"
              ]
            },
            "Null": {
              "aws:RequestTag/NetworkScopeId": "false"
            }
          },
          "Effect": "Allow",
          "Resource": [
            "arn:aws:organizations::*:policy/o-*/network_security_director_policy/*"
          ],
          "Sid": "NSDOrgPolicyCreate"
        },
        {
          "Action": [
            "organizations:DeletePolicy",
            "organizations:UntagResource",
            "organizations:UpdatePolicy"
