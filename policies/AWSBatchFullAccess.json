{
  "Arn": "arn:aws:iam::aws:policy/AWSBatchFullAccess",
  "CreateDate": "2016-12-06T19:35:42Z",
  "DefaultVersionId": "v8",
  "IsAttachable": true,
  "Path": "/",
  "PolicyId": "ANPAJ7K2KIWB3HZVK3CUO",
  "PolicyName": "AWSBatchFullAccess",
  "PolicyVersion": {
    "CreateDate": "2026-11-04T18:37:08Z",
    "Document": {
      "Statement": [
        {
          "Action": [
            "iam:CreateServiceLinkedRole"
          ],
          "Condition": {
            "StringEquals": {
              "iam:AWSServiceName": "batch.amazonaws.com"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:iam::*:role/*Batch*"
        },
        {
          "Action": "eks:AssociateAccessPolicy",
          "Condition": {
            "StringEquals": {
              "eks:accessScope": "cluster",
              "eks:policyArn": "arn:aws:eks::aws:cluster-access-policy/AWSBatchClusterPolicy"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:eks:*:*:access-entry/*/role/*/AWSServiceRoleForBatch/*",
          "Sid": "BatchEksAccessEntryAssociatePolicy"
        },
        {
          "Action": "eks:CreateAccessEntry",
          "Condition": {
            "ArnLike": {
              "eks:principalArn": "arn:aws:iam::*:role/aws-service-role/batch.amazonaws.com/AWSServiceRoleForBatch"
            }
          },
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "BatchEksAccessEntryCreate"
        },
        {
          "Action": [
            "batch:*",
            "cloudwatch:GetMetricStatistics",
            "ec2:DescribeImages",
            "ec2:DescribeKeyPairs",
            "ec2:DescribeLaunchTemplateVersions",
            "ec2:DescribeLaunchTemplates",
            "ec2:DescribeSecurityGroups",
            "ec2:DescribeSubnets",
            "ec2:DescribeVpcs",
            "ecs:Describe*",
            "ecs:DescribeClusters",
            "ecs:List*",
            "eks:DescribeCluster",
            "eks:ListClusters",
            "iam:ListInstanceProfiles",
            "iam:ListRoles",
            "logs:Describe*",
            "logs:FilterLogEvents",
            "logs:Get*",
            "logs:TestMetricFilter"
          ],
          "Effect": "Allow",
          "Resource": "*"
        },
        {
          "Action": [
            "iam:PassRole"
          ],
          "Effect": "Allow",
          "Resource": [
            "arn:aws:iam::*:instance-profile/ecsInstanceRole",
            "arn:aws:iam::*:role/AWSBatchJobRole*",
            "arn:aws:iam::*:role/AWSBatchServiceRole",
            "arn:aws:iam::*:role/aws-ec2-spot-fleet-role",
            "arn:aws:iam::*:role/ecsInstanceRole",
            "arn:aws:iam::*:role/iaws-ec2-spot-fleet-role",
            "arn:aws:iam::*:role/service-role/AWSBatchServiceRole"
          ]
        },
        {
          "Action": [
            "eks:DeleteAccessEntry",
            "eks:DescribeAccessEntry"
          ],
          "Effect": "Allow",
          "Resource": "arn:aws:eks:*:*:access-entry/*/role/*/AWSServiceRoleForBatch/*",
          "Sid": "BatchEksAccessEntryManage"
        }
      ],
      "Version": "2012-10-17"
    },
    "IsDefaultVersion": true,
    "VersionId": "v8"
  },
  "UpdateDate": "2026-11-04T18:37:08Z"
}
