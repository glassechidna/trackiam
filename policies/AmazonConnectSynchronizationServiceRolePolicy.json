            "wisdom:ListAIPrompts",
            "wisdom:ListAssistantAssociations",
            "wisdom:ListAssistants",
            "wisdom:ListContentAssociations",
            "wisdom:ListContents",
            "wisdom:ListKnowledgeBases",
            "wisdom:ListModels",
            "wisdom:ListQuickResponses",
            "wisdom:ListTagsForResource",
