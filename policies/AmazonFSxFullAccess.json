{
  "Arn": "arn:aws:iam::aws:policy/AmazonFSxFullAccess",
  "CreateDate": "2018-11-28T16:34:43Z",
  "DefaultVersionId": "v14",
  "IsAttachable": true,
  "Path": "/",
  "PolicyId": "ANPAIEUV6Z2X4VNZRVB5I",
  "PolicyName": "AmazonFSxFullAccess",
  "PolicyVersion": {
    "CreateDate": "2026-11-21T20:07:07Z",
    "Document": {
      "Statement": [
        {
          "Action": "iam:CreateServiceLinkedRole",
          "Condition": {
            "StringEquals": {
              "iam:AWSServiceName": [
                "fsx.amazonaws.com"
              ]
            }
          },
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "CreateSLRForFSx"
        },
        {
          "Action": "iam:CreateServiceLinkedRole",
          "Condition": {
            "StringEquals": {
              "iam:AWSServiceName": [
                "s3.data-source.lustre.fsx.amazonaws.com"
              ]
            }
          },
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "CreateSLRForLustreS3Integration"
        },
        {
          "Action": [
            "ec2:CreateTags"
          ],
          "Condition": {
            "ForAnyValue:StringEquals": {
              "aws:CalledVia": [
                "fsx.amazonaws.com"
              ]
            },
            "StringEquals": {
              "aws:RequestTag/AmazonFSx": "ManagedByAmazonFSx"
            }
          },
          "Effect": "Allow",
          "Resource": [
            "arn:aws:ec2:*:*:route-table/*"
          ],
          "Sid": "CreateTags"
        },
        {
          "Action": [
            "ec2:DescribeRouteTables",
            "ec2:DescribeSecurityGroups",
            "ec2:DescribeSubnets",
            "ec2:DescribeVpcs",
            "ec2:GetSecurityGroupsForVpc"
          ],
          "Condition": {
            "ForAnyValue:StringEquals": {
              "aws:CalledVia": [
                "fsx.amazonaws.com"
              ]
            }
          },
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "DescribeEC2VpcResources"
        },
        {
          "Action": [
            "fsx:DeleteResourcePolicy",
            "fsx:GetResourcePolicy",
            "fsx:PutResourcePolicy"
          ],
          "Condition": {
            "ForAnyValue:StringEquals": {
              "aws:CalledVia": [
                "ram.amazonaws.com"
              ]
            }
          },
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "ManageCrossAccountDataReplication"
        },
        {
          "Action": [
            "ds:DescribeDirectories"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "ViewAWSDSDirectories"
        },
        {
          "Action": [
            "firehose:PutRecord"
          ],
          "Effect": "Allow",
          "Resource": [
            "arn:aws:firehose:*:*:deliverystream/aws-fsx-*"
          ],
          "Sid": "WriteToAmazonKinesisDataFirehose"
        },
        {
          "Action": [
            "fsx:AssociateFileGateway",
            "fsx:AssociateFileSystemAliases",
            "fsx:CancelDataRepositoryTask",
            "fsx:CopyBackup",
            "fsx:CopySnapshotAndUpdateVolume",
            "fsx:CreateAndAttachS3AccessPoint",
            "fsx:CreateBackup",
            "fsx:CreateClusterPeer",
            "fsx:CreateDataRepositoryAssociation",
            "fsx:CreateDataRepositoryTask",
            "fsx:CreateFileCache",
            "fsx:CreateFileSystem",
            "fsx:CreateFileSystemFromBackup",
            "fsx:CreateSnapmirrorPolicy",
            "fsx:CreateSnapmirrorRelationship",
            "fsx:CreateSnapshot",
            "fsx:CreateSnapshotPolicy",
            "fsx:CreateStorageVirtualMachine",
            "fsx:CreateStorageVirtualMachinePeer",
            "fsx:CreateVolume",
            "fsx:CreateVolumeFromBackup",
            "fsx:DeleteBackup",
            "fsx:DeleteClusterPeer",
            "fsx:DeleteDataRepositoryAssociation",
            "fsx:DeleteFileCache",
            "fsx:DeleteFileSystem",
            "fsx:DeleteSnapmirrorPolicy",
            "fsx:DeleteSnapmirrorRelationship",
            "fsx:DeleteSnapshot",
            "fsx:DeleteSnapshotPolicy",
            "fsx:DeleteStorageVirtualMachine",
            "fsx:DeleteStorageVirtualMachinePeer",
            "fsx:DeleteVolume",
            "fsx:DescribeAssociatedFileGateways",
            "fsx:DescribeBackups",
            "fsx:DescribeClusterPeers",
            "fsx:DescribeDataRepositoryAssociations",
            "fsx:DescribeDataRepositoryTasks",
            "fsx:DescribeFileCaches",
            "fsx:DescribeFileSystemAliases",
            "fsx:DescribeFileSystems",
            "fsx:DescribeS3AccessPointAttachments",
            "fsx:DescribeSharedVpcConfiguration",
            "fsx:DescribeSnapmirrorPolicies",
            "fsx:DescribeSnapmirrorRelationships",
            "fsx:DescribeSnapshotPolicies",
            "fsx:DescribeSnapshots",
            "fsx:DescribeStorageVirtualMachinePeers",
            "fsx:DescribeStorageVirtualMachines",
            "fsx:DescribeVolumes",
            "fsx:DetachAndDeleteS3AccessPoint",
            "fsx:DisassociateFileGateway",
            "fsx:DisassociateFileSystemAliases",
            "fsx:ListTagsForResource",
            "fsx:ManageBackupPrincipalAssociations",
            "fsx:ReleaseFileSystemNfsV3Locks",
            "fsx:RestoreVolumeFromSnapshot",
            "fsx:TagResource",
            "fsx:UntagResource",
            "fsx:UpdateClusterPeer",
            "fsx:UpdateDataRepositoryAssociation",
            "fsx:UpdateFileCache",
            "fsx:UpdateFileSystem",
            "fsx:UpdateSharedVpcConfiguration",
            "fsx:UpdateSnapmirrorPolicy",
            "fsx:UpdateSnapmirrorRelationship",
            "fsx:UpdateSnapshot",
            "fsx:UpdateSnapshotPolicy",
            "fsx:UpdateStorageVirtualMachine",
            "fsx:UpdateStorageVirtualMachinePeer",
            "fsx:UpdateVolume"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "FullAccessToFSx"
        },
        {
          "Action": [
            "logs:CreateLogGroup",
            "logs:CreateLogStream",
            "logs:PutLogEvents"
          ],
          "Effect": "Allow",
          "Resource": [
            "arn:aws:logs:*:*:log-group:/aws/fsx/*"
          ],
          "Sid": "CreateLogsForFSxWindowsAuditLogs"
        }
      ],
      "Version": "2012-10-17"
    },
    "IsDefaultVersion": true,
    "VersionId": "v14"
  },
  "UpdateDate": "2026-11-21T20:07:07Z"
}
