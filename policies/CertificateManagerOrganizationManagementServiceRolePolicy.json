{
  "Arn": "arn:aws:iam::aws:policy/aws-service-role/CertificateManagerOrganizationManagementServiceRolePolicy",
  "CreateDate": "2026-11-19T18:47:08Z",
  "DefaultVersionId": "v1",
  "IsAttachable": true,
  "Path": "/aws-service-role/",
  "PolicyId": "ANPAZKAPJZG4AUAKLOOYM",
  "PolicyName": "CertificateManagerOrganizationManagementServiceRolePolicy",
  "PolicyVersion": {
    "CreateDate": "2026-11-19T18:47:08Z",
    "Document": {
      "Statement": [
        {
          "Action": [
            "acm-pca:DeleteCertificateAuthority",
            "acm-pca:RestoreCertificateAuthority",
            "acm-pca:RevokeCertificate",
            "acm-pca:UpdateCertificateAuthority"
          ],
          "Condition": {
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:acm-pca:*:*:certificate-authority/*",
          "Sid": "ManagePrivateCertificateAuthorities"
        },
        {
          "Action": [
            "acm:DeleteCertificate",
            "acm:RenewCertificate",
            "acm:RevokeCertificate",
            "acm:UpdateCertificateOptions"
          ],
          "Condition": {
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:acm:*:*:certificate/*",
          "Sid": "ManageACMCertificates"
        }
      ],
      "Version": "2012-10-17"
    },
    "IsDefaultVersion": true,
    "VersionId": "v1"
  },
  "UpdateDate": "2026-11-19T18:47:08Z"
}
