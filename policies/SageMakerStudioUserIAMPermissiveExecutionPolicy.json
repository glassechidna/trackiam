    "Document": {
      "Statement": [
        {
          "Action": "iam:AttachRolePolicy",
          "Condition": {
            "ArnEquals": {
              "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/SageMakerStudioEMRContainersSystemNamespaceRolePolicy"
