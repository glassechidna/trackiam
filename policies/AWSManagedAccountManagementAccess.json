{
  "Arn": "arn:aws:iam::aws:policy/AWSManagedAccountManagementAccess",
  "CreateDate": "2026-07-20T19:57:12Z",
  "DefaultVersionId": "v2",
  "IsAttachable": true,
  "Path": "/",
  "PolicyId": "ANPAZKAPJZG4DHB27L5MN",
  "PolicyName": "AWSManagedAccountManagementAccess",
  "PolicyVersion": {
    "CreateDate": "2026-10-01T19:07:08Z",
    "Document": {
      "Statement": [
        {
          "Action": "sts:AssumeRole",
          "Condition": {
            "StringEquals": {
              "aws:ResourceOrgID": "${aws:PrincipalOrgID}"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:*:iam::*:role/managed/AWSManagedAccountManagementAccessRole"
        },
        {
          "Action": [
            "iam:AttachRolePolicy",
            "iam:CreateRole",
            "iam:DeleteRole",
            "iam:DeleteRolePermissionsBoundary",
            "iam:DeleteRolePolicy",
            "iam:DetachRolePolicy",
            "iam:GetRole",
            "iam:ListAttachedRolePolicies",
            "iam:ListRolePolicies",
            "iam:PutRolePermissionsBoundary",
            "iam:PutRolePolicy",
            "iam:TagRole",
            "iam:UntagRole",
            "iam:UpdateAssumeRolePolicy",
            "iam:UpdateRole"
          ],
          "Effect": "Allow",
          "Resource": "arn:*:iam::*:role/managed/*"
        }
      ],
      "Version": "2012-10-17"
    },
    "IsDefaultVersion": true,
    "VersionId": "v2"
  },
  "UpdateDate": "2026-10-01T19:07:08Z"
}
