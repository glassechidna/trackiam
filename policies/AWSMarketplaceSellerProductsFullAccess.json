{
  "Arn": "arn:aws:iam::aws:policy/AWSMarketplaceSellerProductsFullAccess",
  "CreateDate": "2019-07-02T21:06:25Z",
  "DefaultVersionId": "v18",
  "IsAttachable": true,
  "Path": "/",
  "PolicyId": "ANPAZKAPJZG4DS2YFEG4N",
  "PolicyName": "AWSMarketplaceSellerProductsFullAccess",
  "PolicyVersion": {
    "CreateDate": "2026-11-20T05:27:07Z",
    "Document": {
      "Statement": [
        {
          "Action": [
            "iam:PassRole"
          ],
          "Condition": {
            "StringEquals": {
              "iam:PassedToService": "assets.marketplace.amazonaws.com"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:iam::*:role/*",
          "Sid": "IAMPassRoleAccess"
        },
        {
          "Action": [
            "partnercentral-account-management:AccessLegacyPartnerCentral"
          ],
          "Condition": {
            "ForAnyValue:StringEquals": {
              "partnercentral-account-management:LegacyPartnerCentralRole": "TechnicalStaff"
            }
          },
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "LegacyPartnerCentralAccess"
        },
        {
          "Action": [
            "partnercentral:GetConnection"
          ],
          "Condition": {
            "StringEquals": {
              "partnercentral:Catalog": [
                "AWS",
                "Sandbox"
              ]
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:partnercentral:*::catalog/*/connection/*",
          "Sid": "ReadAccountConnections"
        },
        {
          "Action": [
            "partnercentral:ListConnections"
          ],
          "Condition": {
            "StringEquals": {
              "partnercentral:Catalog": [
                "AWS",
                "Sandbox"
              ]
            }
          },
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "ListAccountConnections"
        },
        {
          "Action": [
            "aws-marketplace:CancelChangeSet",
            "aws-marketplace:DescribeChangeSet",
            "aws-marketplace:DescribeEntity",
            "aws-marketplace:StartAssessment",
            "aws-marketplace:StartChangeSet"
          ],
          "Effect": "Allow",
          "Resource": "arn:aws:aws-marketplace:*:*:AWSMarketplace*/*",
          "Sid": "MarketplaceResourceAccess"
        },
        {
          "Action": [
            "aws-marketplace:DeleteResourcePolicy",
            "aws-marketplace:GetResourcePolicy",
            "aws-marketplace:PutResourcePolicy"
          ],
          "Effect": "Allow",
          "Resource": "arn:aws:aws-marketplace:*:*:AWSMarketplace*/*",
          "Sid": "ResourceSharingAccess"
        },
        {
          "Action": [
            "aws-marketplace:DescribeAssessment"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "MarketplaceAssessmentAccess"
        },
        {
          "Action": [
            "aws-marketplace:GetDeploymentConfiguration",
            "aws-marketplace:GetDeploymentConfigurationJob",
            "aws-marketplace:ListDeploymentConfigurationJobs",
            "aws-marketplace:StartDeploymentConfigurationJob"
          ],
          "Effect": "Allow",
          "Resource": "arn:aws:aws-marketplace:*:*:DeploymentConfiguration:catalogs/AWSMarketplace/*",
          "Sid": "DeploymentConfigurationManagement"
        },
        {
          "Action": [
            "aws-marketplace:ListAssessments",
            "aws-marketplace:ListChangeSets",
            "aws-marketplace:ListEntities"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "MarketplaceListAccess"
        },
        {
          "Action": [
            "aws-marketplace:ListTagsForResource",
            "aws-marketplace:TagResource",
            "aws-marketplace:UntagResource"
          ],
          "Effect": "Allow",
          "Resource": [
            "arn:aws:aws-marketplace:*:*:AWSMarketplace*/*",
            "arn:aws:aws-marketplace:*:*:DeploymentConfiguration:catalogs/AWSMarketplace/*"
          ],
          "Sid": "TagAccess"
        },
        {
          "Action": [
            "ec2:DescribeImages",
            "ec2:DescribeSnapshots",
            "ec2:ModifyImageAttribute",
            "ec2:ModifySnapshotAttribute"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "EC2ResourceAccess"
        },
        {
          "Action": [
            "iam:GetRole"
          ],
          "Effect": "Allow",
          "Resource": "arn:aws:iam::*:role/*",
          "Sid": "GetIAMRoleAccess"
        },
        {
          "Action": [
            "q:GetConversation",
            "q:ListConversations",
            "q:PassRequest",
            "q:SendMessage",
            "q:StartConversation"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "AmazonQPartnerAssistantAccess"
        },
        {
          "Action": [
            "s3:PutObject"
          ],
          "Effect": "Allow",
          "Resource": [
            "arn:aws:s3:::aws-partner-central-marketplace-ephemeral-writeonly-files/${aws:PrincipalAccount}/*"
          ],
          "Sid": "MarketplaceEphemeralWriteS3Access"
        },
        {
          "Action": [
            "support-console:CheckSubscription",
            "support-console:GetAccountGovCloudEnabled",
            "support-console:GetAccountState",
            "support-console:GetBanner"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "SupportConsole"
        },
        {
          "Action": [
            "support:AddAttachmentsToSet",
            "support:AddCommunicationToCase",
            "support:CreateCase",
            "support:DescribeAttachment",
            "support:DescribeCases",
            "support:DescribeCommunications",
            "support:DescribeCreateCaseOptions",
            "support:DescribeServices",
            "support:ResolveCase",
            "support:SearchForCases"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "Support"
        },
        {
          "Action": [
            "vendor-insights:GetDataSource",
            "vendor-insights:GetSecurityProfile",
            "vendor-insights:GetSecurityProfileSnapshot",
            "vendor-insights:ListDataSources",
            "vendor-insights:ListSecurityProfileSnapshots",
            "vendor-insights:ListSecurityProfiles"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "VendorInsightsAccess"
        }
      ],
      "Version": "2012-10-17"
    },
    "IsDefaultVersion": true,
    "VersionId": "v18"
  },
  "UpdateDate": "2026-11-20T05:27:07Z"
}
