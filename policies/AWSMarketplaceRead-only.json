{
  "Arn": "arn:aws:iam::aws:policy/AWSMarketplaceRead-only",
  "CreateDate": "2015-02-06T18:40:31Z",
  "DefaultVersionId": "v14",
  "IsAttachable": true,
  "Path": "/",
  "PolicyId": "ANPAJOOM6LETKURTJ3XZ2",
  "PolicyName": "AWSMarketplaceRead-only",
  "PolicyVersion": {
    "CreateDate": "2026-11-18T17:57:11Z",
    "Document": {
      "Statement": [
        {
          "Action": [
            "aws-marketplace:GetAgreementApproval",
            "aws-marketplace:GetAgreementRequest",
            "aws-marketplace:GetAgreementRequestApprovalPlans",
            "aws-marketplace:GetAgreementRequestTerms"
          ],
          "Condition": {
            "ForAllValues:StringEquals": {
              "aws-marketplace:AgreementType": [
                "PurchaseAgreement"
              ]
            },
            "Null": {
              "aws-marketplace:AgreementType": "false"
            }
          },
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "AWSMarketplaceAgreementRequestAndApprovalReadAccess"
        },
        {
          "Action": [
            "aws-marketplace:GetAgreementContacts"
          ],
          "Condition": {
            "ForAllValues:StringEquals": {
              "aws-marketplace:AgreementType": [
                "PurchaseAgreement"
              ]
            },
            "Null": {
              "aws-marketplace:AgreementType": "false"
            }
          },
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "AWSMarketplaceAgreementContactsReadAccess"
        },
        {
          "Action": [
            "aws-marketplace:DescribePrivateMarketplaceRequests",
            "aws-marketplace:GetAgreementPaymentRequest",
            "aws-marketplace:ListAgreementPaymentRequests",
            "aws-marketplace:ListPrivateMarketplaceRequests"
          ],
          "Effect": "Allow",
          "Resource": "*"
        },
        {
          "Action": [
            "aws-marketplace:GetAgreementCancellationRequest",
            "aws-marketplace:ListAgreementCancellationRequests"
          ],
          "Effect": "Allow",
          "Resource": "*"
        },
        {
          "Action": [
            "aws-marketplace:GetListing",
            "aws-marketplace:GetOffer",
            "aws-marketplace:GetOfferSet",
            "aws-marketplace:GetOfferTerms",
            "aws-marketplace:GetProduct",
            "aws-marketplace:ListFulfillmentOptions",
            "aws-marketplace:ListPurchaseOptions",
            "aws-marketplace:SearchFacets",
            "aws-marketplace:SearchListings"
          ],
          "Effect": "Allow",
          "Resource": [
            "arn:aws:aws-marketplace:::catalog/AWSMarketplace*/listing/*",
            "arn:aws:aws-marketplace:::catalog/AWSMarketplace*/offer/*",
            "arn:aws:aws-marketplace:::catalog/AWSMarketplace*/offerSet/*",
            "arn:aws:aws-marketplace:::catalog/AWSMarketplace*/product/*",
            "arn:aws:aws-marketplace:::catalog/AWSMarketplace*/purchaseOption/*"
          ]
        },
        {
          "Action": [
            "aws-marketplace:ListAgreementCharges",
            "aws-marketplace:ViewSubscriptions",
            "ec2:DescribeAccountAttributes",
            "ec2:DescribeAddresses",
            "ec2:DescribeImages",
            "ec2:DescribeInstances",
            "ec2:DescribeKeyPairs",
            "ec2:DescribeSecurityGroups",
            "ec2:DescribeSubnets",
            "ec2:DescribeVpcs"
          ],
          "Effect": "Allow",
          "Resource": "*"
        },
        {
          "Action": [
            "aws-marketplace:ListPrivateListings"
          ],
          "Effect": "Allow",
          "Resource": "*"
        },
        {
          "Action": [
            "iam:ListInstanceProfiles",
            "iam:ListRoles",
            "sns:GetTopicAttributes",
            "sns:ListTopics"
          ],
          "Effect": "Allow",
          "Resource": "*"
        },
        {
          "Action": [
            "aws-marketplace:GetDeploymentConfiguration"
          ],
          "Effect": "Allow",
          "Resource": "arn:aws:aws-marketplace:*:*:DeploymentConfiguration:catalogs/AWSMarketplace/*",
          "Sid": "AWSMarketplaceDeploymentConfigurationReadAccess"
        },
        {
          "Action": [
            "aws-marketplace:ListAgreementApprovals",
            "aws-marketplace:ListAgreementRequests"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "AWSMarketplaceAgreementRequestAndApprovalListAccess"
        }
      ],
      "Version": "2012-10-17"
    },
    "IsDefaultVersion": true,
    "VersionId": "v14"
  },
  "UpdateDate": "2026-11-18T17:57:11Z"
}
