{
  "Arn": "arn:aws:iam::aws:policy/aws-service-role/AmazonSageMakerInferenceServiceRolePolicy",
  "CreateDate": "2026-07-30T19:42:26Z",
  "DefaultVersionId": "v1",
  "IsAttachable": true,
  "Path": "/aws-service-role/",
  "PolicyId": "ANPAZKAPJZG4OVZ22IKHX",
  "PolicyName": "AmazonSageMakerInferenceServiceRolePolicy",
  "PolicyVersion": {
    "CreateDate": "2026-07-30T19:42:26Z",
    "Document": {
      "Statement": [
        {
          "Action": [
            "ec2:CreateNetworkInterface"
          ],
          "Condition": {
            "StringEquals": {
              "aws:RequestTag/AmazonSageMakerManaged": "true",
              "aws:ResourceAccount": "${aws:PrincipalAccount}"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:ec2:*:*:network-interface/*",
          "Sid": "CreateENIWithTag"
        },
        {
          "Action": [
            "ec2:CreateNetworkInterface"
          ],
          "Condition": {
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}"
            }
          },
          "Effect": "Allow",
          "Resource": [
            "arn:aws:ec2:*:*:security-group/*",
            "arn:aws:ec2:*:*:subnet/*"
          ],
          "Sid": "CreateENIInSubnetAndSG"
        },
        {
          "Action": [
            "ec2:CreateNetworkInterfacePermission"
          ],
          "Condition": {
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}",
              "aws:ResourceTag/AmazonSageMakerManaged": "true",
              "ec2:AuthorizedService": "sagemaker.amazonaws.com",
              "ec2:Permission": "INSTANCE-ATTACH"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:ec2:*:*:network-interface/*",
          "Sid": "CreateENIPermission"
        },
        {
          "Action": [
            "ec2:CreateTags"
          ],
          "Condition": {
            "StringEquals": {
              "aws:RequestTag/AmazonSageMakerManaged": "true",
              "aws:ResourceAccount": "${aws:PrincipalAccount}",
              "ec2:CreateAction": "CreateNetworkInterface"
            }
          },
          "Effect": "Allow",
          "Resource": [
            "arn:aws:ec2:*:*:network-interface/*"
          ],
          "Sid": "TagOnCreateSageMakerResourcesForENI"
        },
        {
          "Action": [
            "ec2:DeleteNetworkInterface"
          ],
          "Condition": {
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}",
              "aws:ResourceTag/AmazonSageMakerManaged": "true"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:ec2:*:*:network-interface/*",
          "Sid": "DeleteENITagScoped"
        },
        {
          "Action": [
            "ec2:DeleteNetworkInterfacePermission"
          ],
          "Condition": {
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}",
              "aws:ResourceTag/AmazonSageMakerManaged": "true"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:ec2:*:*:network-interface/*",
          "Sid": "DeleteENIPermissionTagScoped"
        },
        {
          "Action": [
            "ec2:DescribeDhcpOptions",
            "ec2:DescribeNetworkInterfaces",
            "ec2:DescribeSecurityGroups",
            "ec2:DescribeSubnets",
            "ec2:DescribeVpcs"
          ],
          "Condition": {
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}"
            }
          },
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "DescribeNetworkResources"
        }
      ],
      "Version": "2012-10-17"
    },
    "IsDefaultVersion": true,
    "VersionId": "v1"
  },
  "UpdateDate": "2026-07-30T19:42:26Z"
}
