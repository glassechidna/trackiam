{
  "Arn": "arn:aws:iam::aws:policy/AWSQuickSetupStartSSMAssociationsExecutionPolicy",
  "CreateDate": "2025-08-08T12:04:07Z",
  "DefaultVersionId": "v8",
  "IsAttachable": true,
  "Path": "/",
  "PolicyId": "ANPAZKAPJZG4JPUVBQPNJ",
  "PolicyName": "AWSQuickSetupStartSSMAssociationsExecutionPolicy",
  "PolicyVersion": {
    "CreateDate": "2026-10-27T15:57:08Z",
    "Document": {
      "Statement": [
        {
          "Action": "iam:PassRole",
          "Condition": {
            "ArnLike": {
              "iam:AssociatedResourceARN": [
                "arn:aws:ssm:*:*:automation-definition/AWSQuickSetupType-Scheduler-ChangeCalendarState*",
                "arn:aws:ssm:*:*:automation-execution/*",
                "arn:aws:ssm:*:*:document/AWSQuickSetupType-Scheduler-ChangeCalendarState"
              ]
            },
            "StringEquals": {
              "iam:PassedToService": [
                "ssm.amazonaws.com"
              ]
            }
          },
          "Effect": "Allow",
          "Resource": [
            "arn:aws:iam::*:role/AWS-QuickSetup*"
          ]
        },
        {
          "Action": "ssm:GetCalendarState",
          "Condition": {
            "StringEquals": {
              "ssm:DocumentType": "ChangeCalendar"
            },
            "StringLike": {
              "aws:userid": "*:SystemsManager-Automation-ChangeCalendar-Check"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:ssm:*:*:document/*"
        },
        {
          "Action": [
            "ssm:StartAutomationExecution"
          ],
          "Effect": "Allow",
          "Resource": [
            "arn:aws:ssm:*:*:automation-definition/AWSQuickSetupType-Scheduler-ChangeCalendarState*",
            "arn:aws:ssm:*:*:automation-execution/*",
            "arn:aws:ssm:*:*:document/AWSQuickSetupType-Scheduler-ChangeCalendarState"
          ]
        }
      ],
      "Version": "2012-10-17"
    },
    "IsDefaultVersion": true,
    "VersionId": "v8"
  },
  "UpdateDate": "2026-10-27T15:57:08Z"
}
