{
  "Arn": "arn:aws:iam::aws:policy/AWSPartnerCentralOpportunityManagement",
  "CreateDate": "2024-11-14T19:09:05Z",
  "DefaultVersionId": "v14",
  "IsAttachable": true,
  "Path": "/",
  "PolicyId": "ANPAZKAPJZG4OANYBNL3Z",
  "PolicyName": "AWSPartnerCentralOpportunityManagement",
  "PolicyVersion": {
    "CreateDate": "2026-11-20T03:37:07Z",
    "Document": {
      "Statement": [
        {
          "Action": [
            "partnercentral-account-management:AccessLegacyPartnerCentral"
          ],
          "Condition": {
            "ForAnyValue:StringEquals": {
              "partnercentral-account-management:LegacyPartnerCentralRole": "AceManager"
            }
          },
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "LegacyPartnerCentralAccess"
        },
        {
          "Action": [
            "partnercentral:AcceptEngagementInvitation",
            "partnercentral:AssignOpportunity",
            "partnercentral:AssociateOpportunity",
            "partnercentral:CreateEngagement",
            "partnercentral:CreateEngagementContext",
            "partnercentral:CreateEngagementInvitation",
            "partnercentral:CreateOpportunity",
            "partnercentral:CreateResourceSnapshot",
            "partnercentral:CreateResourceSnapshotJob",
            "partnercentral:DeleteResourceSnapshotJob",
            "partnercentral:DisassociateOpportunity",
            "partnercentral:GetAwsOpportunitySummary",
            "partnercentral:GetCustomerAccountStatistics",
            "partnercentral:GetEngagement",
            "partnercentral:GetEngagementInvitation",
            "partnercentral:GetOpportunity",
            "partnercentral:GetOpportunityBulkJobReportUrl",
            "partnercentral:GetProspectingFromEngagementTask",
            "partnercentral:GetResourceSnapshot",
            "partnercentral:GetResourceSnapshotJob",
            "partnercentral:ListCustomerAccountBulkJobs",
            "partnercentral:ListEngagementByAcceptingInvitationTasks",
            "partnercentral:ListEngagementFromOpportunityTasks",
            "partnercentral:ListEngagementGroups",
            "partnercentral:ListEngagementInvitations",
            "partnercentral:ListEngagementMembers",
            "partnercentral:ListEngagementResourceAssociations",
            "partnercentral:ListEngagements",
            "partnercentral:ListOpportunities",
            "partnercentral:ListOpportunityBulkJobResults",
            "partnercentral:ListOpportunityBulkJobs",
            "partnercentral:ListOpportunityFromEngagementTasks",
            "partnercentral:ListProspectingFromEngagementTasks",
            "partnercentral:ListResourceSnapshotJobs",
            "partnercentral:ListResourceSnapshots",
            "partnercentral:ListSolutions",
            "partnercentral:RejectEngagementInvitation",
            "partnercentral:SearchCustomerAccounts",
            "partnercentral:SearchEngagements",
            "partnercentral:SearchOpportunities",
            "partnercentral:StartCustomerAccountBulkJob",
            "partnercentral:StartEngagementByAcceptingInvitationTask",
            "partnercentral:StartEngagementFromOpportunityTask",
            "partnercentral:StartOpportunityBulkJob",
            "partnercentral:StartOpportunityFromEngagementTask",
            "partnercentral:StartProspectingFromEngagementTask",
            "partnercentral:StartResourceSnapshotJob",
            "partnercentral:StopResourceSnapshotJob",
            "partnercentral:SubmitOpportunity",
            "partnercentral:UpdateEngagementContext",
            "partnercentral:UpdateOpportunity"
          ],
          "Condition": {
            "StringEquals": {
              "partnercentral:Catalog": [
                "AWS",
                "Sandbox"
              ]
            }
          },
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "OpportunityManagement"
        },
        {
          "Action": [
            "partnercentral:CreateCustomerAccount",
            "partnercentral:DeleteCustomerAccount",
            "partnercentral:GetCustomerAccount",
            "partnercentral:UpdateCustomerAccount"
          ],
          "Condition": {
            "StringEquals": {
              "partnercentral:Catalog": [
                "AWS",
                "Sandbox"
              ]
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:partnercentral:*:*:catalog/*/customer-account/*",
          "Sid": "CustomerAccountManagement"
        },
        {
          "Action": [
            "partnercentral:GetCustomerAccountBulkJob",
            "partnercentral:GetCustomerAccountBulkJobReportUrl",
            "partnercentral:ListCustomerAccountBulkJobResults"
          ],
          "Condition": {
            "StringEquals": {
              "partnercentral:Catalog": [
                "AWS",
                "Sandbox"
              ]
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:partnercentral:*:*:catalog/*/customer-account-bulk-job/*",
          "Sid": "CustomerAccountBulkJobAccess"
        },
        {
          "Action": [
            "partnercentral:GetPartner",
            "partnercentral:ListPartners"
          ],
          "Condition": {
            "StringEquals": {
              "partnercentral:Catalog": [
                "AWS",
                "Sandbox"
              ]
            }
          },
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "PartnerResourceAccess"
        },
        {
          "Action": [
            "partnercentral:GetPartnerCentralContentDocument",
            "partnercentral:GetPartnerCentralContentMetadata",
            "partnercentral:ListPartnerCentralContent",
            "partnercentral:SearchPartnerCentralContent"
          ],
          "Condition": {
            "StringEquals": {
              "partnercentral:Catalog": [
                "AWS",
                "Sandbox"
              ]
            }
          },
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "PartnerCentralContentAccess"
        },
        {
          "Action": [
            "partnercentral:ListTagsForResource",
            "partnercentral:TagResource",
            "partnercentral:UntagResource"
          ],
          "Condition": {
            "StringEquals": {
              "partnercentral:Catalog": [
                "AWS",
                "Sandbox"
              ]
            }
          },
          "Effect": "Allow",
          "Resource": [
            "arn:aws:partnercentral:*:*:catalog/*/customer-account/*",
            "arn:aws:partnercentral:*:*:catalog/*/opportunity/*",
            "arn:aws:partnercentral:*:*:catalog/*/resource-snapshot-job/*"
          ],
          "Sid": "TaggingAccess"
        },
        {
          "Action": [
            "partnercentral:UseSession"
          ],
          "Condition": {
            "Bool": {
              "aws:IsMcpServiceAction": "true"
            },
            "StringEquals": {
              "partnercentral:Catalog": [
                "AWS",
                "Sandbox"
              ]
            }
          },
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "PartnerCentralAgentsSessionAccess"
        },
        {
          "Action": "s3:PutObject",
          "Effect": "Allow",
          "Resource": "arn:aws:s3:::aws-partner-central-marketplace-ephemeral-writeonly-files/${aws:PrincipalAccount}/*",
          "Sid": "PartnerCentralBulkFileUpload"
        },
        {
          "Action": [
            "aws-marketplace:DescribeEntity"
          ],
          "Effect": "Allow",
          "Resource": [
            "arn:aws:aws-marketplace:*:*:AWSMarketplace*/Offer/*",
            "arn:aws:aws-marketplace:*:*:AWSMarketplace*/OfferSet/*",
            "arn:aws:aws-marketplace:*:*:AWSMarketplace*/Solution/*"
          ],
          "Sid": "AWSMarketplaceEntityAccess"
        },
        {
          "Action": [
            "aws-marketplace:ListEntities"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "ListingAWSMarketplaceEntities"
        },
        {
          "Action": [
            "partnercentral:CreateCollaborationChannelMembers",
            "partnercentral:CreateCollaborationChannelRequest",
            "partnercentral:GetCollaborationChannel",
            "partnercentral:ListCollaborationChannels"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "CollaborationChannelAccess"
        },
        {
          "Action": [
            "partnercentral:CreateDataSubscription",
            "partnercentral:DeleteDataSubscription",
            "partnercentral:GetDataSubscription",
            "partnercentral:ListTagsForResource",
            "partnercentral:TagResource",
            "partnercentral:UntagResource"
          ],
          "Effect": "Allow",
          "Resource": [
            "arn:aws:partnercentral::*:catalog/AWS/ReportingData/Engagement_V1/DataSubscription/*",
            "arn:aws:partnercentral::*:catalog/AWS/ReportingData/Opportunity_V1/DataSubscription/*"
          ],
          "Sid": "PartnerDataSubscriptionAccess"
        },
        {
          "Action": [
            "partnercentral:GetPartnerDashboard"
          ],
          "Effect": "Allow",
          "Resource": [
            "arn:aws:partnercentral::*:catalog/AWS/ReportingData/Engagement_V1/Dashboard/*",
            "arn:aws:partnercentral::*:catalog/AWS/ReportingData/Opportunity_V1/Dashboard/*"
          ],
          "Sid": "PartnerDashboardAccess"
        },
        {
          "Action": [
            "partnercentral:GetPartnerReportingData"
          ],
          "Effect": "Allow",
          "Resource": [
            "arn:aws:partnercentral::*:catalog/AWS/ReportingData/Engagement_V1/Dataset/*",
            "arn:aws:partnercentral::*:catalog/AWS/ReportingData/Opportunity_V1/Dataset/*"
          ],
          "Sid": "PartnerReportingDataAccess"
        },
        {
          "Action": [
            "partnercentral:ListDataSubscriptions"
          ],
          "Effect": "Allow",
          "Resource": "arn:aws:partnercentral::*:catalog/AWS",
          "Sid": "PartnerDataSubscriptionList"
        },
        {
          "Action": [
            "q:GetConversation",
            "q:ListConversations",
            "q:PassRequest",
            "q:SendMessage",
            "q:StartConversation"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "AmazonQPartnerAssistantAccess"
        },
        {
          "Action": [
            "support-console:CheckSubscription",
            "support-console:GetAccountGovCloudEnabled",
            "support-console:GetAccountState",
            "support-console:GetBanner"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "SupportConsole"
        },
        {
          "Action": [
            "support:AddAttachmentsToSet",
            "support:AddCommunicationToCase",
            "support:CreateCase",
            "support:DescribeAttachment",
            "support:DescribeCases",
            "support:DescribeCommunications",
            "support:DescribeCreateCaseOptions",
            "support:DescribeServices",
            "support:ResolveCase",
            "support:SearchForCases"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "Support"
        }
      ],
      "Version": "2012-10-17"
    },
    "IsDefaultVersion": true,
    "VersionId": "v14"
  },
  "UpdateDate": "2026-11-20T03:37:07Z"
}
