{
  "Arn": "arn:aws:iam::aws:policy/aws-service-role/AWSAgentRegistryServiceRolePolicy",
  "CreateDate": "2026-08-06T14:27:17Z",
  "DefaultVersionId": "v1",
  "IsAttachable": true,
  "Path": "/aws-service-role/",
  "PolicyId": "ANPAZKAPJZG4PFFBTXAWO",
  "PolicyName": "AWSAgentRegistryServiceRolePolicy",
  "PolicyVersion": {
    "CreateDate": "2026-08-06T14:27:17Z",
    "Document": {
      "Statement": [
        {
          "Action": [
            "cloudwatch:PutMetricData"
          ],
          "Condition": {
            "StringEquals": {
              "aws:ResourceAccount": "${aws:PrincipalAccount}",
              "cloudwatch:namespace": [
                "AWS/AgentRegistry",
                "AWS/Usage"
              ]
            }
          },
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "AllowPublishCloudWatchMetrics"
        }
      ],
      "Version": "2012-10-17"
    },
    "IsDefaultVersion": true,
    "VersionId": "v1"
  },
  "UpdateDate": "2026-08-06T14:27:17Z"
}
