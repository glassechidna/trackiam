{
  "Arn": "arn:aws:iam::aws:policy/KiroVpcConnectionPolicy",
  "CreateDate": "2026-11-16T23:27:08Z",
  "DefaultVersionId": "v1",
  "IsAttachable": true,
  "Path": "/",
  "PolicyId": "ANPAZKAPJZG4AY3JJEEJJ",
  "PolicyName": "KiroVpcConnectionPolicy",
  "PolicyVersion": {
    "CreateDate": "2026-11-16T23:27:08Z",
    "Document": {
      "Statement": [
        {
          "Action": "ec2:CreateNetworkInterface",
          "Condition": {
            "ForAllValues:StringEquals": {
              "aws:TagKeys": [
                "ManagedByKiro"
              ]
            },
            "StringEquals": {
              "aws:RequestTag/ManagedByKiro": ""
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:ec2:*:*:network-interface/*",
          "Sid": "CreateKiroNetworkInterface"
        },
        {
          "Action": "ec2:CreateNetworkInterfacePermission",
          "Condition": {
            "StringEquals": {
              "aws:ResourceTag/ManagedByKiro": "",
              "ec2:Permission": "INSTANCE-ATTACH"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:ec2:*:*:network-interface/*",
          "Sid": "AllowAttachOfKiroNetworkInterface"
        },
        {
          "Action": "ec2:CreateTags",
          "Condition": {
            "ForAllValues:StringEquals": {
              "aws:TagKeys": [
                "ManagedByKiro"
              ]
            },
            "StringEquals": {
              "aws:RequestTag/ManagedByKiro": "",
              "ec2:CreateAction": "CreateNetworkInterface"
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:ec2:*:*:network-interface/*",
          "Sid": "TagKiroNetworkInterfaceOnCreate"
        },
        {
          "Action": "ec2:DeleteNetworkInterface",
          "Condition": {
            "StringEquals": {
              "aws:ResourceTag/ManagedByKiro": ""
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:ec2:*:*:network-interface/*",
          "Sid": "DeleteKiroNetworkInterface"
        },
        {
          "Action": "ec2:ModifyNetworkInterfaceAttribute",
          "Condition": {
            "StringEquals": {
              "aws:ResourceTag/ManagedByKiro": ""
            }
          },
          "Effect": "Allow",
          "Resource": "arn:aws:ec2:*:*:network-interface/*",
          "Sid": "ModifyKiroNetworkInterfaceAttribute"
        },
        {
          "Action": "ec2:CreateNetworkInterface",
          "Effect": "Allow",
          "Resource": [
            "arn:aws:ec2:*:*:security-group/*",
            "arn:aws:ec2:*:*:subnet/*"
          ],
          "Sid": "UseSubnetAndSecurityGroupForKiroNetworkInterface"
        },
        {
          "Action": "ec2:ModifyNetworkInterfaceAttribute",
          "Effect": "Allow",
          "Resource": "arn:aws:ec2:*:*:instance/*",
          "Sid": "ModifyNetworkInterfaceAttributeOnEnvironmentInstance"
        },
        {
          "Action": [
            "ec2:DescribeDhcpOptions",
            "ec2:DescribeNetworkInterfaces",
            "ec2:DescribeSecurityGroups",
            "ec2:DescribeSubnets",
            "ec2:DescribeVpcs"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "ReadVpcConfiguration"
        }
      ],
      "Version": "2012-10-17"
    },
    "IsDefaultVersion": true,
    "VersionId": "v1"
  },
  "UpdateDate": "2026-11-16T23:27:08Z"
}
