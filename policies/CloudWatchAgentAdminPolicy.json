        {
          "Action": [
            "ssm:GetParameter",
            "ssm:PutParameter"
          ],
          "Effect": "Allow",
          "Resource": "arn:aws:ssm:*:*:parameter/AmazonCloudWatch-*",
          "Sid": "CWASSMPermissions"
        }
      ],
