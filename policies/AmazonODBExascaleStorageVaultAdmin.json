{
  "Arn": "arn:aws:iam::aws:policy/job-function/AmazonODBExascaleStorageVaultAdmin",
  "CreateDate": "2026-09-04T21:37:07Z",
  "DefaultVersionId": "v1",
  "IsAttachable": true,
  "Path": "/job-function/",
  "PolicyId": "ANPAZKAPJZG4PPHO7I6ZR",
  "PolicyName": "AmazonODBExascaleStorageVaultAdmin",
  "PolicyVersion": {
    "CreateDate": "2026-09-04T21:37:07Z",
    "Document": {
      "Statement": [
        {
          "Action": [
            "iam:CreateServiceLinkedRole"
          ],
          "Condition": {
            "StringEquals": {
              "iam:AWSServiceName": [
                "odb.amazonaws.com"
              ]
            }
          },
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "AllowSLRActions"
        },
        {
          "Action": [
            "ec2:DescribeAvailabilityZones"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "AllowEC2Actions"
        },
        {
          "Action": [
            "odb:CreateExascaleDbStorageVault",
            "odb:DeleteExascaleDbStorageVault",
            "odb:DeleteResourcePolicy",
            "odb:GetDbServer",
            "odb:GetExascaleDbStorageVault",
            "odb:GetOciOnboardingStatus",
            "odb:GetResourcePolicy",
            "odb:InitializeService",
            "odb:ListDbServers",
            "odb:ListDbSystemShapes",
            "odb:ListExadbVmClusters",
            "odb:ListExascaleDbStorageVaults",
            "odb:ListFlexComponents",
            "odb:ListTagsForResource",
            "odb:PutResourcePolicy",
            "odb:UpdateExascaleDbStorageVault"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "AllowODBActions"
        },
        {
          "Action": [
            "odb:TagResource",
            "odb:UntagResource"
          ],
          "Effect": "Allow",
          "Resource": [
            "arn:aws:odb:*:*:exascale-db-storage-vault/*"
          ],
          "Sid": "AllowTaggingActions"
        }
      ],
      "Version": "2012-10-17"
    },
    "IsDefaultVersion": true,
    "VersionId": "v1"
  },
  "UpdateDate": "2026-09-04T21:37:07Z"
}
