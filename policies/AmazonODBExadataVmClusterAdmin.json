{
  "Arn": "arn:aws:iam::aws:policy/job-function/AmazonODBExadataVmClusterAdmin",
  "CreateDate": "2026-09-04T21:37:08Z",
  "DefaultVersionId": "v1",
  "IsAttachable": true,
  "Path": "/job-function/",
  "PolicyId": "ANPAZKAPJZG4KTLF2X7ZI",
  "PolicyName": "AmazonODBExadataVmClusterAdmin",
  "PolicyVersion": {
    "CreateDate": "2026-09-04T21:37:08Z",
    "Document": {
      "Statement": [
        {
          "Action": [
            "ec2:DescribeAvailabilityZones"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "AllowEC2Actions"
        },
        {
          "Action": [
            "odb:AssociateIamRoleToResource",
            "odb:CreateCloudVmCluster",
            "odb:CreateDbNode",
            "odb:DeleteCloudVmCluster",
            "odb:DeleteDbNode",
            "odb:DisassociateIamRoleFromResource",
            "odb:GetCloudExadataInfrastructure",
            "odb:GetCloudExadataInfrastructureUnallocatedResources",
            "odb:GetCloudVmCluster",
            "odb:GetDbNode",
            "odb:GetDbServer",
            "odb:GetOciOnboardingStatus",
            "odb:GetOdbNetwork",
            "odb:InitializeService",
            "odb:ListCloudExadataInfrastructures",
            "odb:ListCloudVmClusters",
            "odb:ListDbNodes",
            "odb:ListDbServers",
            "odb:ListDbSystemShapes",
            "odb:ListFlexComponents",
            "odb:ListGiVersions",
            "odb:ListOdbNetworks",
            "odb:ListSystemVersions",
            "odb:ListTagsForResource",
            "odb:RebootDbNode",
            "odb:StartDbNode",
            "odb:StopDbNode"
          ],
          "Effect": "Allow",
          "Resource": "*",
          "Sid": "AllowODBActions"
        },
        {
          "Action": [
            "odb:CreateOutboundIntegration",
            "odb:UpdateOutboundIntegration"
          ],
          "Effect": "Allow",
          "Resource": [
            "arn:aws:odb:*:*:cloud-vm-cluster/*"
          ],
          "Sid": "AllowOutboundIntegrationActions"
        },
        {
          "Action": [
            "odb:TagResource",
            "odb:UntagResource"
          ],
          "Effect": "Allow",
          "Resource": [
            "arn:aws:odb:*:*:cloud-vm-cluster/*",
            "arn:aws:odb:*:*:db-node/*"
          ],
          "Sid": "AllowTaggingActions"
        }
      ],
      "Version": "2012-10-17"
    },
    "IsDefaultVersion": true,
    "VersionId": "v1"
  },
  "UpdateDate": "2026-09-04T21:37:08Z"
}
